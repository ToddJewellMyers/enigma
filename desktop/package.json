{
  "name": "enigma-desktop",
  "version": "0.1.0",
  "description": "Desktop editions of the Enigma Kanban application",
  "author": "Todd Jewell Myers",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "dev": "ENIGMA_DEV_URL=http://localhost:5173 electron .",
    "dist": "npm run dist:community",
    "dist:community": "electron-builder --config electron-builder.community.yml --mac",
    "dist:community:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.community.yml --mac",
    "dist:mas": "electron-builder --config electron-builder.mas.yml --mac mas",
    "verify:mas-structure": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.mas.yml --mac mas --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  }
}
